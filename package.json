{
  "name": "np3-lab",
  "version": "0.6.5",
  "private": true,
  "description": "Unofficial Mac app for Nikon Z Flexible Color Picture Controls (.NP3): manage recipes on your SD card, preview them, and edit your own.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "app": "vite build && electron .",
    "app:dev": "node scripts/dev-app.mjs",
    "dist:mac": "vite build && electron-builder --mac --arm64",
    "icons": "node scripts/make-icons.mjs",
    "build:ios": "CAP_BUILD=1 vite build && cap sync ios",
    "build:android": "CAP_BUILD=1 vite build && cap sync android",
    "apk": "npm run build:android && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run build:android && cd android && ./gradlew assembleRelease"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.2",
    "@types/node": "^26.6.3",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "jszip": "^3.10.2",
    "nikon-flexible-color-picture-control": "1.0.0",
    "preact": "^10.29.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  },
  "productName": "NP3 Lab",
  "author": "Min Jun (MJ-best)",
  "main": "electron/main.mjs",
  "build": {
    "appId": "io.github.mj-best.np3lab",
    "productName": "NP3 Lab",
    "files": [
      "dist/NP3-Lab.html",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.photography",
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "NP3 Lab"
    },
    "artifactName": "NP3-Lab-${version}-${arch}.${ext}",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MJ-best/np3-lab.git"
  },
  "homepage": "https://github.com/MJ-best/np3-lab"
}
