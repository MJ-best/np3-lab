{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/refs/heads/v2/crates/tauri-cli/schema.json",
  "productName": "NP3 Lab",
  "version": "0.7.0",
  "identifier": "io.github.mj-best.np3lab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NP3 Lab",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#000000"
      }
    ],
    "trayIcon": {
      "iconPath": "icons/128x128.png",
      "tooltip": "NP3 Lab"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Photography",
    "macOS": {
      "frameworks": [
        "DiskArbitration"
      ],
      "minimumSystemVersion": "12.0"
    }
  }
}
